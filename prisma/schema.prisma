// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Comment model — stores user comments from the landing page.
// Supports full CRUD operations via the /api/comments route.
// sessionId is used for client-side ownership verification.
model Comment {
  id        String   @id @default(cuid())
  name      String   // Name of the commenter
  message   String   // Comment body / review text
  sessionId String   // Browser session identifier (UUID v4) for ownership check
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
